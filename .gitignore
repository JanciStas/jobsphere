# ...but SQL that IS part of the repo must stay committable (Prisma migrations,
# RLS policies, docker seed). Without these negations `git add` silently skips
# every newly generated migration.
!**/prisma/migrations/**/*.sql
!apps/web/prisma/*.sql
!packages/db/prisma/*.sql
!docker/*.sql
!remediation/*.sql


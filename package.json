{
  "name": "jobsphere",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual AI-powered HR ATS and Job Board Platform",
  "license": "MIT",
  "author": "JobSphere Team",
  "type": "module",
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,html,yml,yaml}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:reset": "turbo db:reset",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "test:db:up": "docker compose -f docker/docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker/docker-compose.test.yml down -v",
    "test:db:reset": "yarn test:db:down && yarn test:db:up && yarn test:db:migrate",
    "test:db:migrate": "yarn --cwd apps/web prisma migrate deploy --schema ../../packages/db/prisma/schema.prisma",
    "check:drift": "node scripts/check-migration-drift.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {},
  "resolutions": {
    "@xmldom/xmldom": "^0.8.12"
  }
}
